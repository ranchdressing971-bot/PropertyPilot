# OpenAI (required for Live mode — server-side only, no NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (required for sign-in + data persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Your public site URL (no trailing slash)
# Vercel: https://your-app.vercel.app (or your custom domain)
# Local: http://localhost:3000
# Vercel also sets VERCEL_URL automatically — set this explicitly for Stripe/custom domain
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: attach dynamic community prices to one Product (prod_...)
# STRIPE_PRODUCT_ID=prod_...
# Legacy fixed prices (no longer required — checkout uses P(c)=99*c^0.7):
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...

# Optional — name shown at top of Stripe Checkout (default: RideBy)
# STRIPE_CHECKOUT_DISPLAY_NAME=RideBy

# Resend (violation emails)
# Product/transactional email ONLY. Resend's Acceptable Use Policy prohibits cold
# outreach and scraped contacts, so Nexus must never send through this account.
RESEND_FROM_EMAIL=RideBy <notifications@yourdomain.com>
RESEND_API_KEY=re_...

# ── Nexus (internal outreach system) ─────────────────────────────────────────
# Google Places API key for the Lead Hand.
# Note: websiteUri and phone are Enterprise-tier fields (1,000 free calls/month).
GOOGLE_PLACES_API_KEY=

# Shared secret for the job runner at /api/nexus/tick. Generate with:
#   openssl rand -hex 32
# Must match the NEXUS_CRON_SECRET repository secret used by the GitHub Action.
NEXUS_CRON_SECRET=

# Accounts allowed to open /nexus. One signed-in email, or several comma separated.
NEXUS_ADMIN_EMAIL=

# Soft ceiling on Google review count for Lead Hand. Companies above this are
# treated as too big (default 75). Already on the Enterprise Places SKU.
# NEXUS_MAX_REVIEW_COUNT=75

# Link pasted into Outreach drafts as the CTA (default: production /free page).
# NEXUS_OUTREACH_CTA_URL=https://rideby-ai.vercel.app/free

# Mailtrap — Nexus cold send (sandbox first; never use Resend for outreach)
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=isaac@outreach.example.com
MAILTRAP_FROM_NAME=Isaac at RideBy
MAILTRAP_SANDBOX=true
# Master kill switch — must be exactly "true" to transmit
NEXUS_SEND_ENABLED=false
# Nova's hard daily ceiling (default 50). Floor when sending is 20.
# NEXUS_MAX_SENDS_PER_DAY=50

# Soft community verification (fingerprints + gentle prompts after analyze).
# Off in production until true; on by default in development.
# Run docs/COMMUNITY_VERIFICATION_SCHEMA.sql in Supabase first.
# COMMUNITY_VERIFICATION_ENABLED=true

# Nova voice (ElevenLabs TTS for /nova replies)
ELEVENLABS_API_KEY=
# Free tier: use a voice from My Voices (library voices need a paid plan).
# Prefer the ID: elevenlabs.io → Voices → your voice → ⋯ → Copy voice ID
# If you only set the display name (e.g. Nova), we resolve it — ID is more reliable.
ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=Nova
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
