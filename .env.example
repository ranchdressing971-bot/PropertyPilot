# OpenAI (required for Live mode — server-side only, no NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (required for sign-in + data persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Your public site URL (no trailing slash)
# Current: https://rideby-ai.vercel.app — switch to https://rideby.live when DNS is live
# Local: http://localhost:3000
# Vercel also sets VERCEL_URL automatically — set this explicitly for Stripe/custom domain
NEXT_PUBLIC_APP_URL=https://rideby-ai.vercel.app

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Recommended: one Product for all community plans (Dashboard → Products → Add).
# Checkout and "add communities" create Prices dynamically on that product.
# Pricing: $299/mo for 1-3; above that max(299, round(99 × c^0.7)).
# Buy-more uses the same table, never below the subscriber's current monthly.
# Fixed Price IDs are NOT required (amounts are computed in app code).
# STRIPE_PRODUCT_ID=prod_...
# Legacy fixed prices (unused for new community checkouts):
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...

# Optional — name shown at top of Stripe Checkout (default: RideBy)
# STRIPE_CHECKOUT_DISPLAY_NAME=RideBy

# Resend — product/transactional today; planned live outreach provider after
# custom domain is verified on Resend. Mailtrap is NOT the go-live path.
RESEND_FROM_EMAIL=RideBy <notifications@yourdomain.com>
RESEND_API_KEY=re_...

# ── Nexus (internal outreach system) ─────────────────────────────────────────
# Google Places API key for the Lead Hand.
# Note: websiteUri and phone are Enterprise-tier fields (1,000 free calls/month).
GOOGLE_PLACES_API_KEY=

# Shared secret for the job runner at /api/nexus/tick. Generate with:
#   openssl rand -hex 32
# Must match the NEXUS_CRON_SECRET repository secret used by the GitHub Action.
NEXUS_CRON_SECRET=

# Accounts allowed to open /nexus. One signed-in email, or several comma separated.
NEXUS_ADMIN_EMAIL=

# Soft ceiling on Google review count for Lead Hand. Companies above this are
# treated as too big (default 75). Already on the Enterprise Places SKU.
# NEXUS_MAX_REVIEW_COUNT=75

# Link pasted into Outreach drafts as the CTA (default: production /free page).
# NEXUS_OUTREACH_CTA_URL=https://rideby-ai.vercel.app/free

# Legacy Mailtrap (not verified / not go-live). Live path will be Resend + domain.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=isaac@outreach.example.com
MAILTRAP_FROM_NAME=Isaac at RideBy
MAILTRAP_SANDBOX=true
# Master kill switch — must be exactly "true" to transmit (after domain + Resend)
NEXUS_SEND_ENABLED=false
# Nova's hard daily ceiling (default 50). Floor when sending is 20.
# NEXUS_MAX_SENDS_PER_DAY=50

# Soft fingerprint prompts (optional map organizing). OFF by default.
# Abuse / under-billing is handled by the community abuse bot instead:
#   Nova tool `abuse` or POST /api/abuse/community-scan
# COMMUNITY_VERIFICATION_ENABLED=true

# Nova voice — server TTS (required for iPhone autoplay; not Web Speech)
# Chain: ElevenLabs → Google en-GB female → OpenAI female (last resort, not British).
ELEVENLABS_API_KEY=
# Your voice ID (⋯ → Copy voice ID). Respected as-is — never overridden.
# Only when unset: defaults to Lily pFZP5JQG7iQjIQuC4Bku.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_NAME=
# Low-latency default: eleven_flash_v2_5 (override for quality if needed).
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Speaking rate 0.7–1.2 (default 1.0).
# ELEVENLABS_SPEED=1.0
# Max TTFA hint 0–4 (default 4).
# ELEVENLABS_OPTIMIZE_LATENCY=4
#
# Google Cloud TTS — real British woman when ElevenLabs is out of credits.
# 1) GCP Console → enable "Cloud Text-to-Speech API"
# 2) Create an API key (restrict to Cloud Text-to-Speech if possible)
# 3) Set on Vercel + redeploy. Do NOT reuse GOOGLE_PLACES_API_KEY unless that
#    key's project also has Text-to-Speech enabled.
GOOGLE_TTS_API_KEY=
# Default: en-GB-Neural2-C (milder British female). Also: en-GB-Neural2-A, en-GB-Wavenet-A.
# Accent strength isn't continuous — voice pick is the control.
# GOOGLE_TTS_VOICE=en-GB-Neural2-C
# Speaking rate 0.25–4.0 (default 1.0).
# GOOGLE_TTS_SPEED=1.0
#
# OpenAI last resort (OPENAI_API_KEY). No convincing British female stock voice
# (`fable` is British but male). Uses natural female — do not fake an accent.
# Low-latency default: tts-1 (not tts-1-hd). Feminine voice nova.
# OPENAI_TTS_MODEL=tts-1
# Feminine default (nova). Also shimmer/coral/sage. Avoid fable/onyx/echo.
# OPENAI_TTS_VOICE=nova
# Speaking rate 0.25–4.0 (default 1.0).
# OPENAI_TTS_SPEED=1.0
# Only used if model is gpt-4o-mini-tts:
# OPENAI_TTS_INSTRUCTIONS=Adult woman. Natural conversational tone. Clear and warm. Not theatrical, not cartoonish.
# Clear stale Vercel OPENAI_TTS_* British-accent overrides — they never sounded British.
